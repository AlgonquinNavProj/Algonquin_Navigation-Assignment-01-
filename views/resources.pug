doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Resources
    link(rel='stylesheet' href='/style.css')

  body
    header.site-header
      .header-top
        img.logo(src='/images/logo.png')
        .title-box The College Guide

    nav.nav-bar
      .nav-left
      .nav-center
        a(href="/") Home
        a(href="/about") About
        a(href="/schedule") Schedule
        a(href="/contact") Contact
        a(href="/resources") Resources
      .nav-right
        a.login-button(href="/login") Login/Register

    main.container
      h2 Student Resources

      section.resource-box
        h3 Student Mental Health
        p Always feel free to use counselling services.
        a(href="https://www.algonquincollege.com/studentsupportservices/student-health-wellness/" target="_blank") Visit Student Health Wellness 
      section.resource-box
        h3 Financial Accommodations
        p Financial aid helps students manage costs.
        a(href="https://www.algonquincollege.com/financial-aid/" target="_blank") Visit Financial Aid
      section.resource-box
        h3 Student Accommodations
        p Access support services for academic needs.
        a(href="https://www.algonquincollege.com/cal/student-resources/" target="_blank") Visit CAL Student Resources
      section.resource-box
        h3 Student Success Specialist
        p Visit academic advisors for guidance.
        a(href="https://www.algonquincollege.com/academic-success/student-success-specialists/" target="_blank") Visit Student Success Specialists
    footer
      p © 2026 The College Guide | Contact us | Privacy | References